; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="eve战棋"
config/description="EVETBS content foundation"
run/main_scene="res://game/board_test.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

MCPRuntime="*res://addons/godot_mcp/runtime/mcp_runtime.gd"

[debug]

gdscript/warnings/inference_on_variant=0

[display]

window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
##Matchprimarydisplay(1920x1080)soGamepreviewratiosmatchshipmonitors.window/size/viewport_width=1920

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[rendering]

anti_aliasing/quality/msaa_3d=2
