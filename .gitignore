# Godot
**/.godot/
*.translation
*.import

# Local engine binary (do not commit)
/tools/godot/
/tools/godot/**

# Art / binary media — local only (not GitHub)
godot_project/assets/
godot_eternal_shell/content_src/assets/
**/assets/_vendor_*/
**/*.glb
**/*.gltf
**/*.fbx
**/*.dds
**/*.ktx
**/*.ktx2
**/*.bnk
**/*.wav
**/*.mp3
**/*.ogg

# Asset acquisition / one-off local scripts (not game body)
tools/vendor_*.ps1
tools/vendor_*.py
tools/_*.py
godot_project/tools/
godot_eternal_shell/tools/_*.py

# Local editor / agent addons (not game body)
godot_project/addons/godot_mcp/
godot_project/addons/godot_mcp/**

# Shell builds / packs / caches
godot_eternal_shell/builds/**
!godot_eternal_shell/builds/**/.gitkeep
godot_eternal_shell/content_dist/**
!godot_eternal_shell/content_dist/**/.gitkeep
godot_eternal_shell/shell/bundled_content/packs/**
!godot_eternal_shell/shell/bundled_content/packs/.gitkeep
godot_eternal_shell/tools/cache/
godot_eternal_shell/tools/cache/**
godot_eternal_shell/tools/_adb_*.png
godot_eternal_shell/installer/._sc_
godot_eternal_shell/shell/._sc_

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Scratch
_*.txt
_*.log
*.tmp
__pycache__/
*.pyc
